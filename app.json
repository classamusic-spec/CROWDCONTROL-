{
  "expo": {
    "name": "Crowd Control Daily",
    "slug": "crowd-control-daily",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "crowdcontroldaily",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/branding/icon.png",
    "splash": {
      "backgroundColor": "#071A3D",
      "resizeMode": "contain",
      "image": "./assets/splash/splash-icon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourstudio.crowdcontroldaily",
      "backgroundColor": "#071A3D"
    },
    "android": {
      "package": "com.yourstudio.crowdcontroldaily",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#071A3D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071A3D",
          "image": "./assets/splash/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
